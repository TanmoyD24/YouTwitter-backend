{
  "name": "youtwitter",
  "version": "1.0.0",
  "description": "a backend for youtwitter",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon -r dotenv/config --experimental-json-modules src/index.js",
    "dev:client": "npm run dev --prefix frontend"
  },
  "keywords": [
    "javascript",
    "backend"
  ],
  "author": "Tanmoy Das",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.3",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.2",
    "mongoose-aggregate-paginate-v2": "^1.1.4",
    "multer": "^2.1.1"
  }
}
